# Local app settings
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional real signing key. Leave empty for deterministic demo signatures.
PROOFJUDGE_SIGNING_KEY=

# Optional LLM settings. The demo judge is local and deterministic until wired.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# EigenCloud deployment metadata can be filled after ecloud deploy.
EIGEN_APP_ID=
EIGEN_INSTANCE_IP=
EIGEN_ATTESTATION_ENDPOINT=
