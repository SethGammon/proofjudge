# Local app settings
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional real signing key. Leave empty for deterministic demo signatures.
PROOFJUDGE_SIGNING_KEY=

# Eigen AI Gateway (used when running in EigenCompute)
# KMS_SERVER_URL and KMS_PUBLIC_KEY are auto-injected by EigenCompute — do not set manually.
# KMS_SERVER_URL=
# KMS_PUBLIC_KEY=
EIGEN_GATEWAY_URL=https://ai-gateway-dev.eigencloud.xyz
LLM_MODEL=anthropic/claude-sonnet-4-5

# EigenCloud deployment metadata — filled automatically after ecloud deploy.
EIGEN_APP_ID=
EIGEN_INSTANCE_IP=
EIGEN_ATTESTATION_ENDPOINT=
