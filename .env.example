# Local app settings
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Preferred public-key signing. Generate both values with npm run signing:provision.
# The private value belongs only in ignored local env files and deployment secrets.
PROOFJUDGE_ED25519_PUBLIC_KEY=
PROOFJUDGE_ED25519_PRIVATE_KEY=

# Legacy receipt verification. New receipts prefer Ed25519 when configured.
PROOFJUDGE_SIGNING_KEY=

# Eigen AI Gateway (used when running in EigenCompute)
# KMS_SERVER_URL and KMS_PUBLIC_KEY are auto-injected by EigenCompute — do not set manually.
# KMS_SERVER_URL=
# KMS_PUBLIC_KEY=
EIGEN_GATEWAY_URL=https://ai-gateway-dev.eigencloud.xyz
LLM_MODEL=anthropic/claude-sonnet-4-5

# EigenCloud deployment metadata — filled automatically after ecloud deploy.
EIGEN_APP_ID=
EIGEN_INSTANCE_IP=
EIGEN_ATTESTATION_ENDPOINT=
