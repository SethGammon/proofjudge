{
  "name": "proofjudge",
  "version": "0.1.0",
  "private": true,
  "description": "ProofJudge: verifiable bounty judging agents for EigenCloud private preview.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/smoke.ts",
    "live:check": "node scripts/live-readiness.mjs",
    "live:verify": "node scripts/live-readiness.mjs --deep",
    "check": "npm run build && npm run smoke"
  },
  "dependencies": {
    "@layr-labs/ai-gateway-provider": "^1.0.1",
    "ai": "^6.0.174",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
